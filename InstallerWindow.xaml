<Window x:Class="Rune.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rune Setup"
        Width="640"
        Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F1117"
        Foreground="#F0F2F5">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6D28D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F0F2F5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Rune Setup Wizard" FontSize="20" FontWeight="Bold" Foreground="#F0F2F5"/>
            <TextBlock Text="Install Rune code editor and configure system shortcuts." FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- Step 1: Options -->
            <StackPanel x:Name="Step1Panel" VerticalAlignment="Center">
                <TextBlock Text="Installation Options" FontSize="14" FontWeight="SemiBold" Foreground="#F0F2F5" Margin="0,0,0,16"/>
                
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Destination Folder:" FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                    <TextBox x:Name="PathTextBox" Text="C:\Program Files\Rune" Padding="8" Background="#161922" Foreground="#F0F2F5" BorderBrush="#2C3242" BorderThickness="1"/>
                </StackPanel>

                <StackPanel>
                    <CheckBox x:Name="DesktopShortcutCheck" Content="Create a desktop shortcut" IsChecked="True" Margin="0,0,0,10"/>
                    <CheckBox x:Name="StartMenuCheck" Content="Create a Start Menu shortcut" IsChecked="True"/>
                </StackPanel>
            </StackPanel>

            <!-- Step 2: Installing -->
            <StackPanel x:Name="Step2Panel" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Installing Rune..." FontSize="16" FontWeight="SemiBold" Foreground="#F0F2F5" Margin="0,0,0,16"/>
                <ProgressBar x:Name="InstallProgress" Height="6" IsIndeterminate="True" Background="#161922" Foreground="#7C3AED" BorderThickness="0" Margin="0,0,0,16"/>
                <TextBlock x:Name="StatusText" Text="Copying assets, UI files, and creating configuration..." FontSize="12" Foreground="#9CA3AF"/>
            </StackPanel>

            <!-- Step 3: Finished -->
            <StackPanel x:Name="Step3Panel" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Installation Complete!" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,10"/>
                <TextBlock Text="Rune has been successfully installed on your system with all UI assets and configuration files." FontSize="13" Foreground="#9CA3AF" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="Cancel" Background="#262B3A" Click="CancelBtn_Click" Margin="0,0,10,0"/>
            <Button x:Name="NextBtn" Content="Install" Click="NextBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
