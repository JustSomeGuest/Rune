<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <ApplicationIcon>Assets\rune.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Assets\rune.ico" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="UI\index.html" LogicalName="rune.ui.index.html" />
        <EmbeddedResource Include="UI\script.js" LogicalName="rune.ui.script.js" />
        <EmbeddedResource Include="UI\style.css" LogicalName="rune.ui.style.css" />
        <EmbeddedResource Include="UI\Assets\*.svg">
            <LogicalName>rune.ui.assets.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="UI\Assets\logo\*">
            <LogicalName>rune.ui.assets.logo.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

</Project>
